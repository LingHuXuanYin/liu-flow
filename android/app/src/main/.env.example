# 流 Flow · CloudBase 配置样板
# 复制本文件为 .env 并填入真实值
# cp .env.example .env

# ---------------------------------------------------------------------------
# 腾讯云 CloudBase（必填）
# ---------------------------------------------------------------------------
# CloudBase 环境 ID（控制台 → 云开发 → 环境卡片顶部）
TCB_ENV_ID=your-env-id-xxxxxx

# CloudBase Publishable Key（前端安全使用，对应 anon 角色）
# 控制台 → 云开发 → 环境 → API 密钥管理 → 创建 Publishable Key
TCB_PUBLISHABLE_KEY=pkey_xxxxxxxxxxxxxxxxxxxxxxxx

# CloudBase 地域（默认上海，对应 PostgreSQL 模式）
# 短信登录仅支持上海；邮箱密码登录全地域支持
TCB_REGION=ap-shanghai

# ---------------------------------------------------------------------------
# 可选：调试开关
# ---------------------------------------------------------------------------
# 设为 true 时，OkHttp 会打印请求/响应日志到 logcat
# DEBUG_LOG_NETWORK=false
